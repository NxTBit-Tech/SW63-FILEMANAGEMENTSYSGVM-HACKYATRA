#PORT=4000
#JWT_SECRET=replace-with-a-long-random-secret

# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction" pooler (port 6543) for a typical stateless API;
# swap to the direct connection (port 5432) if you hit pooler limitations.
#DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
